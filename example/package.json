{
  "name": "react-native-vibration-feedback-example",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "fast-install-project": "cd ../ && npm i --legacy-peer-deps && npm pack && cd ./example && npm i --legacy-peer-deps",
    "fast:pkg": "npm run fast-install-project && npm run dev",
    "start": "hdc rport tcp:8081 tcp:8081; react-native start",
    "test": "jest -c jest/jest.config.js",
    "test:coverage": "jest -c jest/jest.config.js --coverage",
    "codegen": "react-native codegen-harmony --rnoh-module-path ./harmony/entry/oh_modules/@rnoh/react-native-openharmony",
    "bundle:dev": "react-native bundle-harmony --dev --minify=false",
    "bundle:prod": "react-native bundle-harmony --dev=false --minify=true",
    "pack:pkg": "cd ../ && npm i -f && npm pack && cd ./example",
    "install:pkg": "npm uninstall @react-native-ohos/react-native-vibration-feedback && npm pack:pkg && npm i @react-native-ohos/react-native-vibration-feedback@file:../react-native-ohos-react-native-vibration-feedback-1.0.1.tgz",
    "dev": "npm run codegen && react-native bundle-harmony --dev --minify=false",
    "prod": "npm run codegen && npm run bundle:prod",
    "postinstall": "node ./scripts/create-build-profile"
  },
  "dependencies": {
    "@babel/preset-typescript": "^7.27.1",
    "@gorhom/portal": "^1.0.14",
    "memfs": "4.17.2",
    "react": "18.2.0",
    "react-native-harmony": "npm:@react-native-oh/react-native-harmony@^0.72.142",
    "@react-native-ohos/react-native-vibration-feedback": "file:../react-native-ohos-react-native-vibration-feedback-1.0.1.tgz",
    "react-native": "0.72.5",
    "@react-native-oh/react-native-harmony": "^0.72.142",
    "@rnoh/testerino": "file:./rnoh-testerino-0.0.12.tgz",
    "react-use-backlash": "^0.0.25",
    "shallowequal": "^1.1.0",
    "ts-react-memo": "^0.0.2",
    "use-pipe-ts": "^2.0.2",
    "contrast-color": "^1.0.1",
    "debounce": "^1.2.1",
    "clamp": "^1.0.1",
    "concat-color-matrices": "^1.0.0",
    "i18next": "^25.3.2",
    "react-i18next": "^15.6.1",
    "ts-tiny-invariant": "^2.0.4"
  },
  "devDependencies": {
    "@react-native-community/cli": "11.3.10",
    "react-native-svg-transformer": "^1.5.2",
    "@babel/core": "^7.22.10",
    "@babel/plugin-transform-react-jsx": "^7.22.10",
    "@babel/preset-env": "^7.22.10",
    "@babel/preset-flow": "^7.22.10",
    "@babel/runtime": "^7.22.10",
    "@react-native-community/eslint-config": "^3.2.0",
    "@rnoh/react-native-harmony-cli": "npm:@react-native-oh/react-native-harmony-cli@^0.72.142",
    "@react-native-oh/react-native-harmony-cli": "^0.72.142",
    "@tsconfig/react-native": "^3.0.0",
    "@types/jest": "^29.5.4",
    "@types/react": "^18.2.22",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.6.4",
    "eslint": "^8.48.0",
    "jest": "^29.6.4",
    "metro-react-native-babel-preset": "^0.76.8",
    "prettier": "2.8.8",
    "react-test-renderer": "18.2.0",
    "typescript": "5.2.2"
  },
  "overrides": {
    "@react-native-community/cli": "11.3.10",
    "@rnoh/react-native-harmony-cli": "npm:@react-native-oh/react-native-harmony-cli@^0.72.142"
  },
  "resolutions": {
    "@react-native-community/cli": "11.3.10",
    "@babel/core": "^7.20.2",
    "babel-loader": "^8.3.0"
  },
  "engines": {
    "node": ">=18"
  }
}