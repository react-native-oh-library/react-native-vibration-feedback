
{
  "name": "@react-native-ohos/react-native-vibration-feedback",
  "version": "1.0.1",
  "description": "vibration feedback for React Native applications.",
  "main": "index.js",
  "repository": {
		"type": "git",
		"url": "https://atomgit.com/CPF-RN/rntpc_react-native-vibration-feedback.git"
	},
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "codegen-lib": "react-native codegen-lib-harmony --no-safety-check --npm-package-name react-native-vibration-feedback --cpp-output-path ./harmony/vibration_feedback/src/main/cpp/generated --ets-output-path ./harmony/vibration_feedback/src/main/ets/generated --turbo-modules-spec-paths ./src/NativeVibrationFeedback.ts"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "keywords": [
    "react-native",
    "harmony",
    "vibration",
    "feedback"
  ],
  "files": [
    "src",
    "lib",
    "index.js",
    "index.d.ts",
    "CHANGELOG.md",
    "harmony",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "author": "nascimentorafael<rafaell.nascimentoo@gmail.com>",
  "license": "Apache-2.0 license",
  "bugs": {
		"url": "https://atomgit.com/CPF-RN/rntpc_react-native-vibration-feedback/issues"
	},
	"harmony": {
		"alias": "react-native-vibration-feedback"
	},
	"homepage": "https://atomgit.com/CPF-RN/rntpc_react-native-vibration-feedback",
  "peerDependencies": {
    "react-native": "^0.41.2"
  },
  "dependencies": {
    "@react-native-community/cli": "11.4.1",
    "react-native-harmony-cli": "npm:@react-native-oh/react-native-harmony-cli@^0.0.37"
  }
}
